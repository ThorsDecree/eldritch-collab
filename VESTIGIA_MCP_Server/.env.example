# Live, immediately-current unpacked Archive tree.
VESTIGIA_MCP_LIVE_ARCHIVE_ROOT=C:\\path\\to\\Anima_live

# Latest stable snapshot. May be an unpacked directory or a .zip file.
VESTIGIA_MCP_SNAPSHOT_ARCHIVE_ROOT=C:\\path\\to\\Anima.zip

# MCP-owned state only. Never point this inside either Archive source.
VESTIGIA_MCP_STATE_DIR=C:\\path\\to\\vestigia-mcp-state

# Identifies this deployment in audit receipts.
VESTIGIA_MCP_DEPLOYMENT_ID=local-desktop

# Maximum UTF-8 text file size returned by archive.read_text.
VESTIGIA_MCP_ARCHIVE_TEXT_MAX_BYTES=1000000
