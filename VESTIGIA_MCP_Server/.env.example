# Live, immediately-current unpacked Archive tree.
VESTIGIA_MCP_LIVE_ARCHIVE_ROOT=C:\\path\\to\\Anima_live

# Latest stable snapshot. May be an unpacked directory or a .zip file.
VESTIGIA_MCP_SNAPSHOT_ARCHIVE_ROOT=C:\\path\\to\\Anima.zip

# MCP-owned state only. Never point this inside either Archive source.
VESTIGIA_MCP_STATE_DIR=C:\\path\\to\\vestigia-mcp-state

# Identifies this deployment in audit receipts.
VESTIGIA_MCP_DEPLOYMENT_ID=local-desktop

# Maximum UTF-8 text file size returned by archive.read_text.
VESTIGIA_MCP_ARCHIVE_TEXT_MAX_BYTES=1000000

# Maximum raster image size returned by archive.read_media.
VESTIGIA_MCP_ARCHIVE_MEDIA_MAX_BYTES=20000000

# Optional comma-separated live-Archive-relative prefixes for canonical UTF-8 text staging
# and promotion. Empty means no canonical Archive write authority. Promotion also requires
# a durable stage, its exact proposal digest, and an unchanged captured base hash.
VESTIGIA_MCP_ARCHIVE_WRITE_PREFIXES=

# Maximum UTF-8 bytes in one staged/promoted canonical Archive text file.
VESTIGIA_MCP_ARCHIVE_WRITE_MAX_BYTES=1000000

# Optional JSON registry of named external read-only directories. Tools accept only a mount ID
# plus relative paths. Copy mounts.example.json to ignored mounts.local.json and use an absolute
# path here. Restart the server after changing the registry.
VESTIGIA_MCP_MOUNTS_FILE=

# Optional: expose one VESTIGIA Runtime Home through Runtime's own read-only
# CapabilityRegistry/HousePort projection. Leave blank to disable Runtime linkage.
VESTIGIA_MCP_RUNTIME_HOME=C:\\path\\to\\VESTIGIA_Runtime\\homes\\resident

# Optional explicit Runtime env file. Prefer an explicit path when the Runtime Home
# needs deployment-specific configuration; the MCP bridge does not initialize a provider.
VESTIGIA_MCP_RUNTIME_ENV_FILE=C:\\path\\to\\VESTIGIA_Runtime\\.env

# Optional comma-separated Runtime action grants for runtime.write. Empty means no write
# authority. These are checked again against Runtime's live non-outward local-mutation
# contracts. A useful bounded starting set is:
# fs.stage_patch,file.write,file.patch,fs.patch_discard
VESTIGIA_MCP_RUNTIME_WRITE_ACTIONS=

# Optional multi-house registry. When present, this file replaces the three legacy single-home
# Runtime variables above. Copy runtimes.example.json to ignored runtimes.local.json, fill in
# absolute paths, and set this to that file's absolute path.
VESTIGIA_MCP_RUNTIMES_FILE=


# Optional independent Daemon-Bridge peer. When enabled, MCP can inspect Bridge status,
# discover residents/capabilities, and dispatch private transient resident consults.
# The adapter is fixed to loopback and does not accept arbitrary URLs.
VESTIGIA_MCP_DAEMON_BRIDGE_ENABLED=false
VESTIGIA_MCP_DAEMON_BRIDGE_HOST=127.0.0.1
VESTIGIA_MCP_DAEMON_BRIDGE_PORT=8766

# Point this at the bearer token generated by Daemon-Bridge v9.0.
VESTIGIA_MCP_DAEMON_BRIDGE_TOKEN_PATH=C:\\path\\to\\DaemonBridge\\data\\system\\bridge_api_token

# Model-backed resident consults may take longer than ordinary local reads.
VESTIGIA_MCP_DAEMON_BRIDGE_TIMEOUT_SECONDS=120

# Maximum JSON bytes accepted from one Daemon-Bridge response.
VESTIGIA_MCP_DAEMON_BRIDGE_MAX_RESPONSE_BYTES=262144
