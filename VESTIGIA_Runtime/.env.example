# VESTIGIA Runtime local configuration template
#
# Copy this file to .env and fill only the values you need.
# Never commit real API keys or Discord bot tokens.
#
# IMPORTANT: unless you pass --env-file PATH, VESTIGIA reads .env and .env.local
# from the PROCESS CURRENT WORKING DIRECTORY, not automatically from the home
# directory or from .venv\Scripts.

# -----------------------------------------------------------------------------
# Provider
# -----------------------------------------------------------------------------

# Required by the current OpenAI-compatible provider client for live text calls.
# For OpenAI, use a real OpenAI API key.
# For a local OpenAI-compatible server such as Ollama, a nonempty dummy value such
# as "ollama" may be used when the server itself does not authenticate this field.
OPENAI_API_KEY=

VESTIGIA_PROVIDER=openai
VESTIGIA_API_STYLE=responses
OPENAI_BASE_URL=

# Current built-in aliases. Override only when you want different model names.
# VESTIGIA_MODEL_DEFAULT=gpt-5-mini
# VESTIGIA_MODEL_BIG=gpt-5.6
# VESTIGIA_MODEL_THINKING=gpt-5.6
# VESTIGIA_MODEL_IMAGE=gpt-image-2
# VESTIGIA_MODEL_VISION=gpt-5-mini
# VESTIGIA_REASONING_EFFORT=medium

# Local Ollama / other OpenAI-compatible text example:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# VESTIGIA_API_STYLE=chat_completions
# VESTIGIA_MODEL_DEFAULT=your-local-model-name
#
# If that endpoint does not implement OpenAI image/vision APIs, keep these off:
# VESTIGIA_IMAGES_ENABLED=false
# VESTIGIA_VISION_ENABLED=false

# -----------------------------------------------------------------------------
# Context and retrieval
# -----------------------------------------------------------------------------

# VESTIGIA_CONTEXT_TOKENS=20000
# VESTIGIA_RESIDENT_MAX_TOTAL_TOKENS=20000
# VESTIGIA_RETRIEVAL_LIMIT=18
# VESTIGIA_AUTO_EXTRACT_MEMORY=true
# VESTIGIA_SAVE_FULL_CONTEXT=false

# Optional Archive-through-MCP ContextSource. OFF by default.
# Install the Runtime `mcp-context` extra and the sibling VESTIGIA MCP package first.
# The source launches a local stdio child and forwards only Archive paths plus an
# MCP-owned receipt directory; provider/Discord/tunnel credentials are not forwarded.
# Retrieved Archive evidence is ephemeral prompt context, not Runtime memory or canon.
# VESTIGIA_CONTEXT_MCP_ENABLED=false
# VESTIGIA_CONTEXT_MCP_LIVE_ARCHIVE_ROOT=C:\path\to\VESTIGIA
# VESTIGIA_CONTEXT_MCP_SNAPSHOT_ARCHIVE_ROOT=C:\path\to\VESTIGIA\Anima.zip
# VESTIGIA_CONTEXT_MCP_RESIDENT_KEY=Liora
# VESTIGIA_CONTEXT_MCP_PREFIX=
# VESTIGIA_CONTEXT_MCP_MAX_ITEMS=8
# VESTIGIA_CONTEXT_MCP_MAX_TERMS=5
# VESTIGIA_CONTEXT_MCP_TOKENS=2200
# VESTIGIA_CONTEXT_MCP_ANCHOR_CHARS=12000
# VESTIGIA_CONTEXT_MCP_TIMEOUT_SECONDS=30
# VESTIGIA_CONTEXT_MCP_ARCHIVE_TEXT_MAX_BYTES=1000000

# -----------------------------------------------------------------------------
# House / resident tools
# -----------------------------------------------------------------------------

VESTIGIA_HOUSE_ENABLED=true
# VESTIGIA_RESIDENT_MAX_PRIVATE_TURNS=6
# VESTIGIA_HOUSE_TOOL_CALLS=12
# VESTIGIA_HOUSE_RESULT_TOKENS=6000
# VESTIGIA_HOUSE_MAX_FILE_BYTES=5000000

VESTIGIA_FORGE_ENABLED=true
# VESTIGIA_FORGE_MAX_STEPS=6

# Remote Library Window is OFF by default.
VESTIGIA_WEB_ENABLED=false
VESTIGIA_WEB_ALLOW_HTTP=false

# -----------------------------------------------------------------------------
# Images / vision
# -----------------------------------------------------------------------------

VESTIGIA_IMAGES_ENABLED=true
VESTIGIA_IMAGE_EDITS_ENABLED=true
VESTIGIA_VISION_ENABLED=true
VESTIGIA_OCR_ENABLED=true
# Windows example:
# VESTIGIA_OCR_BINARY=C:\Program Files\Tesseract-OCR\tesseract.exe

# -----------------------------------------------------------------------------
# Discord doorway (optional)
# -----------------------------------------------------------------------------

DISCORD_BOT_TOKEN=
VESTIGIA_DISCORD_ENABLED=false
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
VESTIGIA_DISCORD_ALLOW_DMS=true
VESTIGIA_DISCORD_AMBIENT_VISIBILITY=allowlisted_only
VESTIGIA_DISCORD_LOG_REJECTIONS=false

# -----------------------------------------------------------------------------
# Bells / curation
# -----------------------------------------------------------------------------

VESTIGIA_BELLS_ENABLED=true
# VESTIGIA_BELL_TIMEZONE=UTC
# VESTIGIA_BELL_QUIET_START=22:00
# VESTIGIA_BELL_QUIET_END=08:00

VESTIGIA_CURATION_ENABLED=true
# VESTIGIA_CURATION_CADENCE=3
